# Dograh deployment environment template (innotelinc/dograh — vai.innotel.us)
# Copy to .env and fill in real secrets. .env is gitignored — never commit it.
#
# Generate secrets with: openssl rand -hex 32

ENVIRONMENT=production

# Canonical public host/base URL for this install.
SERVER_IP=73.68.203.71
PUBLIC_HOST=vai.innotel.us
PUBLIC_BASE_URL=https://vai.innotel.us

# Backend API endpoint (public URL the backend uses to build webhook/embed links)
BACKEND_API_ENDPOINT=https://vai.innotel.us

# Public URL browsers use to fetch objects from MinIO (proxied by nginx)
MINIO_PUBLIC_ENDPOINT=https://vai.innotel.us

# TURN Server Configuration (time-limited credentials via TURN REST API)
TURN_HOST=vai.innotel.us
TURN_SECRET=CHANGE_ME
FORCE_TURN_RELAY=false

# JWT secret for OSS authentication
OSS_JWT_SECRET=CHANGE_ME

# PostgreSQL password. Baked into the postgres data volume on first init.
# Do NOT change after first start.
POSTGRES_PASSWORD=CHANGE_ME

# MinIO credentials (wired through docker-compose.override.yaml)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# Redis password (wired through docker-compose.override.yaml)
REDIS_PASSWORD=CHANGE_ME

# Telemetry (set to false to disable)
ENABLE_TELEMETRY=false

# Number of uvicorn worker processes; nginx load-balances across them
FASTAPI_WORKERS=4
