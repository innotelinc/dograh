__DOGRAH_UPSTREAM_BLOCK__

# Re-resolve upstream hostnames via Docker's embedded DNS. Without this,
# `server api:8000` / `server ui:3010` are resolved once at process start and
# cached for the process lifetime, so after `docker compose up -d` recreates a
# container on a new bridge IP the proxy keeps hammering the dead IP
# ("502 no live upstreams" / "connect() failed (113: Host is unreachable)").
resolver 127.0.0.11 valid=10s;

server {
    listen 80;
    server_name __DOGRAH_PUBLIC_HOST__;

    # NPM (Nginx Proxy Manager, proxy.innotel.us) terminates TLS on the public
    # side and forwards plain HTTP here on port 80. No ACME webroot, TLS
    # redirect, or 443 block is needed — the app always sees
    # X-Forwarded-Proto https below.

    # Backend API and WebSockets - bypass the UI, go straight to the
    # api workers via the least_conn upstream defined above.
    location /api/v1/ {
        proxy_pass http://dograh_api;
        proxy_http_version 1.1;

        # Retry on a dead/restarting worker
        proxy_next_upstream error timeout http_502 http_503 http_504;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Long-lived WebSockets (audio streaming, signaling)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Don't buffer streamed responses
        proxy_buffering off;
        client_max_body_size 100M;
    }

    location / {
        # Variable host: name is resolved per-request through the `resolver`
        # above instead of once at process start, so a ui container recreate
        # (new bridge IP) cannot leave this proxy pointing at a stale address.
        set $ui_upstream http://ui:3010;
        proxy_pass         $ui_upstream;
        proxy_http_version 1.1;

        # Important for WebSockets / hot reload etc.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Rewrite localhost MinIO URLs in API responses to use current domain
        sub_filter 'http://localhost:9000/voice-audio/' 'https://$host/voice-audio/';
        sub_filter_once off;
        sub_filter_types application/json text/html;
    }

    location /voice-audio/ {
        proxy_pass http://minio:9000/voice-audio/;

        proxy_http_version 1.1;

        # Headers for file downloads from MinIO
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Allow large file downloads
        proxy_buffering off;
        client_max_body_size 100M;
    }
}