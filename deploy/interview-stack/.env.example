# ── Required ──────────────────────────────────────────────────────────────
# Strong secret used to sign dograh's JWT tokens
OSS_JWT_SECRET=change-me-to-a-long-random-string

# Must be reachable from INSIDE the n8n container (host LAN IP or public URL).
# For the innotel deployment the API is fronted by NPM at api.vai.innotel.us.
BACKEND_API_ENDPOINT=https://api.vai.innotel.us
PUBLIC_BASE_URL=https://vai.innotel.us

# ── dograh core ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redissecret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── kokoro-fastapi (TTS) ──────────────────────────────────────────────────
# remarker/kokoro-fastapi:latest (CPU) | remarker/kokoro-fastapi-cuda:latest (GPU)
KOKORO_IMAGE=remarker/kokoro-fastapi:latest

# ── speaches (STT, faster-whisper) ────────────────────────────────────────
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest
# Systran/faster-distil-whisper-small.en (CPU-friendly, default) |
# Systran/faster-whisper-large-v3 | deepdml/faster-whisper-large-v3-turbo (better, slower)
SPEACHES_WHISPER_MODEL=Systran/faster-distil-whisper-small.en
SPEACHES_WHISPER_DEVICE=cpu      # cpu | cuda (cuda needs :latest-cuda image)
SPEACHES_WHISPER_COMPUTE_TYPE=int8

# ── 9Router ───────────────────────────────────────────────────────────────
# Set if 9Router ships as a Docker image; otherwise run it on the host and
# delete the nine-router service (dograh + n8n reach it on 127.0.0.1/host.docker.internal:20128)
NINE_ROUTER_IMAGE=

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# Headless owner provisioning (first start) — used for CLI workflow import
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-env
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=admin123

# ── Grist ─────────────────────────────────────────────────────────────────
GRIST_ADMIN_EMAIL=admin@localhost
GRIST_ADMIN_PASSWORD=admin
