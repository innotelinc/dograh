# ── Required ──────────────────────────────────────────────────────────────
# Strong secret used to sign dograh's JWT tokens
OSS_JWT_SECRET=change-me-to-a-long-random-string

# Must be reachable from INSIDE the n8n container (host LAN IP or public URL).
# For the innotel deployment the API is fronted by NPM at api.vai.innotel.us.
BACKEND_API_ENDPOINT=https://api.vai.innotel.us
PUBLIC_BASE_URL=https://vai.innotel.us

# Media-WebSocket auth. If the API is reachable over the public internet (e.g.
# ws.vai.innotel.us → :8000), set a random secret and enforce: the ARI manager mints
# an HMAC token per call and appends it via v() params, the handler verifies it
# (4401 on failure). Set the secret FIRST, watch logs for UNVERIFIED media
# socket, then flip ENFORCE=true.
TELEPHONY_WS_TOKEN_SECRET=
TELEPHONY_WS_TOKEN_ENFORCE=false

# ── dograh core ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redissecret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── kokoro-fastapi (TTS) ──────────────────────────────────────────────────
# ghcr.io/remsky/kokoro-fastapi-cpu:latest (CPU) | :latest-gpu (GPU)
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest

# ── speaches (STT, faster-whisper) ────────────────────────────────────────
# The whisper model is chosen per-request via dograh's STT config (model =
# e.g. Systran/faster-distil-whisper-small.en), not set here.
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_WHISPER_DEVICE=cpu      # cpu | cuda | auto
SPEACHES_WHISPER_COMPUTE_TYPE=int8

# ── 9Router ───────────────────────────────────────────────────────────────
# Set if 9Router ships as a Docker image; otherwise run it on the host and
# delete the nine-router service (dograh + n8n reach it on 127.0.0.1/host.docker.internal:20128)
NINE_ROUTER_IMAGE=

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# Headless owner provisioning (first start) — used for CLI workflow import
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-env
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=admin123

# ── Grist ─────────────────────────────────────────────────────────────────
GRIST_ADMIN_EMAIL=admin@localhost
GRIST_ADMIN_PASSWORD=admin

# ── SigNoz ───────────────────────────────────────────────────────────────
# Session-signing key for the unified signoz binary (UI + API). Set to a long
# random string; defaults to a generated value in the compose if unset.
SIGNOZ_JWT_SECRET=change-me-to-a-long-random-string
